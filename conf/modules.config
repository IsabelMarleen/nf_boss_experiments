process {
    publishDir = [
        path: { "${params.outdir}/${params.exp_name}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]
    errorStrategy = { task.exitStatus == 140 | task.exitStatus == 137 ? 'retry' : 'terminate' }
    maxRetries = 3


    withName: 'addBarcodes' {
        clusterOptions = '--nodes=1 --cpus-per-task=8 --ntasks=1'
        memory = { 32.GB * task.attempt }
        time = { 20.m * task.attempt }
    }

    withName: 'analyse_log' {
        publishDir = [
            path: {"${params.outdir}/${params.exp_name}/results"},
            mode: 'copy'
        ]
        clusterOptions = '--nodes=1 --cpus-per-task=1 --ntasks=1'
        memory = { 8.GB * task.attempt }
        time = { 5.m * task.attempt }
        conda = "${projectDir}/envs/simulation.yaml"
        container = "https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/87/8776235a94a745da74c053f4c2f0c7452be44babb551410832b1dea0a3bc086d/data"
    }

    withName: 'combineBarcodedFq' {
        memory = { 64.GB * params.readnumber.values().size() * task.attempt }
        time  = { 20.min * params.readnumber.values().size() * task.attempt }
    }
    
    withName: 'combineLargeBarcodedFq' {
        memory = { 64.GB * task.attempt }
        time  = { 60.min * task.attempt }
        container = "https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/87/8776235a94a745da74c053f4c2f0c7452be44babb551410832b1dea0a3bc086d/data"
    }

    withName: 'combineRef' {
        clusterOptions = '--nodes=1 --cpus-per-task=1 --ntasks=1'
        memory = { 2.GB * task.attempt }
        time = { 5.m * task.attempt }
    }
 
    withName: 'create_coverage_dataframe' {
        clusterOptions = '--nodes=1 --cpus-per-task=1 --ntasks=1'
        publishDir = [
            path: {"${params.outdir}/${params.exp_name}/results"},
            mode: 'copy'
        ]
        memory = { 12.GB * task.attempt }
        time = { 5.m * task.attempt }
    }

    withName: 'createUnblock_dataframe' {
        publishDir = [
            path: {"${params.outdir}/${params.exp_name}/results"},
            mode: 'copy'
        ]
        clusterOptions = '--nodes=1 --cpus-per-task=1 --ntasks=1'
        memory = { 12.GB * task.attempt }
        time = { 5.m * task.attempt }
    }

    withName: 'getConsensus' {
        clusterOptions = '--nodes=1 --cpus-per-task=1 --ntasks=1'
        memory = { 4.GB * task.attempt }
        time = { 5.m * task.attempt }
        spack = 'bcftools'
        container = 'https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/9e/9e674cbc269b944e50ad4f5846ee92a2196b59d9ed76e9146867c76fb32cb8aa/data'
    }

    withName: 'getRef' {
        clusterOptions = '--nodes=1 --cpus-per-task=1 --ntasks=1'
        memory = { 2.GB * task.attempt }
        time = { 5.m * task.attempt }

    }

    withName: 'getVCF' {
        clusterOptions = '--nodes=1 --cpus-per-task=1 --ntasks=1'
        memory = { 2.GB * task.attempt }
        time = { 5.m * task.attempt }

    }

    withName: 'indexPaf' {
        clusterOptions = '--nodes=1 --cpus-per-task=1 --ntasks=1'
        memory = { 8.GB * task.attempt }
        time = { 30.m * task.attempt }
        container = "https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/f6/f666f3a7c3db2bc3beead920385828167c735d1b3e47530303c12c0cd81329a0/data"
        conda = "${projectDir}/envs/simulation.yaml"
    }

    withName: 'mapPaf_trunc' {
        clusterOptions = '--nodes=1 --cpus-per-task=32 --ntasks=1'
        memory = { 32.GB * task.attempt }
        time = {30.min * params.readnumber.values().size() * params.chromosomes.size() * task.attempt}
        container = "https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/f6/f666f3a7c3db2bc3beead920385828167c735d1b3e47530303c12c0cd81329a0/data"
        conda = "${projectDir}/envs/simulation.yaml"
    }

    withName: 'mapPaf' {
        clusterOptions = '--nodes=1 --cpus-per-task=32 --ntasks=1'
        memory = { 32.GB * task.attempt }
        time = { 30.m * task.attempt }
        conda = "${projectDir}/envs/simulation.yaml"
        container = "https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/f6/f666f3a7c3db2bc3beead920385828167c735d1b3e47530303c12c0cd81329a0/data"
    }

    withName: 'mapSam' {
        clusterOptions = '--nodes=1 --cpus-per-task=32 --ntasks=1'
        memory = { 32.GB * task.attempt }
        time = { 30.m * task.attempt }
        conda = "${projectDir}/envs/simulation.yaml"
        container = "https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/90/90b05084d03e6b3d92e923b983f0ed5785b03169521d4e3bc85152f6c3b32122/data"
    }

    withName: 'MemProfilerunBRSim' {
        clusterOptions = '--nodes=1 --cpus-per-task=32 --ntasks=1'
        memory = { 64.GB * params.readnumber.values().size() * params.chromosomes.size() * task.attempt }
        time = {6.h * params.readnumber.values().size() * params.chromosomes.size() * task.attempt}
        conda = "${projectDir}/envs/boss_profile.yaml"
        publishDir = [
                mode: 'copy',
                pattern: "*_cprofile|logs/*_boss.log"
        ]
    }

    withName: 'pileup' {
        clusterOptions = '--nodes=1 --cpus-per-task=32 --ntasks=1'
        memory = { 1.5.GB * bam.size() * task.attempt }
        time = {1.min * bam.size() * task.attempt}
        conda = "${projectDir}/envs/simulation.yaml"
        container = "https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/b6/b62d54a49751d6761d41b48f7b81b8450190946068bfef21d83a165fd48e4c54/data"
    }

    withName: 'processOtu' {
        clusterOptions = '--nodes=1 --cpus-per-task=1 --ntasks=1'
        memory = { 1.GB * task.attempt }
        time = { 1.m * task.attempt }
    }

    withName: 'recordUnblocks' {
        clusterOptions = '--nodes=1 --cpus-per-task=1 --ntasks=1'
        memory = { 24.GB * task.attempt }
        time = { 10.m * task.attempt }
        conda = "${projectDir}/envs/simulation.yaml"
        container = "https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/82/82850b60e32398db58f09fd538b44ac29fd7b64f62adc1661477614dfbd85066/data"
    }

    withName: 'runBRSim' {
        clusterOptions = '--nodes=4 --cpus-per-task=32 --ntasks=1'
        memory = { 64.GB * task.attempt }
        time = { 12.h * task.attempt }
        conda = "${projectDir}/envs/boss_profile.yaml"
    }

    withName: 'scan_offsets_Paf' {
        clusterOptions = '--nodes=1 --cpus-per-task=32 --ntasks=1'
        memory = { 32.GB * task.attempt }
        time = { 30.m * task.attempt }
        conda = "${projectDir}/envs/boss.yaml"
        container = "https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/99/99949ae2aa4e34667e718a42be92c9064fdd3dae10afeb04fd99b3162c3adfa5/data"
    }

    withName: 'scan_offsetsFq' {
        clusterOptions = '--nodes=1 --cpus-per-task=32 --ntasks=1'
        memory = { 32.GB * task.attempt }
        time = { 30.m * task.attempt }
        conda = "${projectDir}/envs/boss.yaml"
        container = "https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/99/99949ae2aa4e34667e718a42be92c9064fdd3dae10afeb04fd99b3162c3adfa5/data"
    }

    withName: 'separateTarget' {
        clusterOptions = '--nodes=1 --cpus-per-task=1 --ntasks=1'
        memory = { 32.GB * task.attempt }
        time = { 10.m * task.attempt }
        conda = "${projectDir}/envs/simulation.yaml"
        container = "https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/33/33d3e3989ad86b8390397b202c6db499cae435dc34174d67fb36027adf25f41c/data"
    }

    withName: 'simNanofastq' {
        clusterOptions = '--nodes=1 --cpus-per-task=32 --ntasks=1'
        ext.args   = { [
            params.maxlen ? "-max ${params.maxlen}" : '',
            params.medlen ? "-med ${params.umitools_bc_pattern}" : '',
            params.sdlen  ? "-sd ${params.umitools_bc_pattern2}" : ''
        ].minus("").join(' ') }
        memory = { 32.GB * params.chromosomes.size() * task.attempt }
        time = { 1.h * params.chromosomes.size() * task.attempt }
        conda = "${projectDir}/envs/nanosim.yaml"
        container = "https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/7f/7f795a3f3858f4e53d9c2d615e66f704bf27ad6cf1b291901694143a1bd31294/data"
    }

    withName: 'subsetVCF' {
        clusterOptions = '--nodes=1 --cpus-per-task=1 --ntasks=1'
        memory = { 2.GB * task.attempt }
        time = { 5.m * task.attempt }
        spack = 'bcftools'
        container = "https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/9e/9e674cbc269b944e50ad4f5846ee92a2196b59d9ed76e9146867c76fb32cb8aa/data"
    }

    withName: 'TimeProfilerunBRSim' {
        clusterOptions = '--nodes=1 --cpus-per-task=32 --ntasks=1'
        memory = { 64.GB * params.readnumber.values().size() * params.chromosomes.size() * task.attempt }
        time = {6.h * params.readnumber.values().size() * params.chromosomes.size() * task.attempt}
        conda = "${projectDir}/envs/boss_profile.yaml"
        publishDir = [
                mode: 'copy',
                pattern: "*_cprofile|logs/*_boss.log"
        ]
    }

    withName: 'truncateFq' {
        clusterOptions = '--nodes=1 --cpus-per-task=8 --ntasks=1'
        memory = { 32.GB * params.readnumber.values().size() * task.attempt }
        time = { 40.min * params.readnumber.values().size() * task.attempt }
    }

    withName: 'visualise_simulation' {
        publishDir = [
            path: {"${params.outdir}/${params.exp_name}/results"},
            mode: 'copy'
        ]
        clusterOptions = '--nodes=1 --cpus-per-task=1 --ntasks=1'
        memory = { 32.GB * task.attempt }
        time = { 20.m * task.attempt }
        conda = "${projectDir}/envs/visualisation.yaml"
        container = "https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/d5/d5f38f55a40143553c791afd3d338ccc13c7de139c1a1d6ca78f3e389c49c89b/data"
    }

    withName: 'writeToml' {
        clusterOptions = '--nodes=1 --cpus-per-task=1 --ntasks=1'
        memory = { 1.GB * task.attempt }
        time = { 5.m * task.attempt }
    }



}